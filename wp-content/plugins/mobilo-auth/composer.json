{
    "name": "mobilo/mobilo-auth",
    "type": "wordpress-plugin",
    "description": "A comprehensive Firebase Authentication plugin for WordPress with multi-region support, user management, and enhanced security features.",
    "version": "1.0.0",
    "keywords": [
        "wordpress",
        "plugin",
        "firebase",
        "authentication",
        "auth",
        "security"
    ],
    "homepage": "https://buy.mobilocard.com",
    "authors": [
        {
            "name": "Aziz Khan",
            "email": "aziz@logicwind.com",
            "role": "Developer"
        },
        {
            "name": "LogicWind",
            "email": "devtools@logicwind.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "kreait/firebase-php": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpcompatibility/php-compatibility": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "MobiloAuth\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MobiloAuth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress",
        "phpcbf": "phpcbf --standard=WordPress"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "GPL-2.0-or-later"
}